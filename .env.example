# Keitaro Admin API (training stand). Never commit the real key.
KEITARO_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_API_KEY=
# Base URL of the admin UI; campaign links are built as <KEITARO_ADMIN_URL>/#!/campaign.editor/<id>
KEITARO_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin
KEITARO_TIMEOUT=15

# Defaults for new campaigns (can be overridden in the form)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_SOURCE_ID=836
GEO_REDIRECT_URL=https://google.com

# Cache TTLs, seconds
OFFERS_CACHE_TTL=3600
REFERENCE_CACHE_TTL=3600

# Local run (docker compose overrides the host to "db")
DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot
POSTGRES_DB=adrobot

LOG_LEVEL=INFO
